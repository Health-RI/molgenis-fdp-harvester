# Example environment for the MOLGENIS FDP harvester.
#
# Copy to .env and fill in your own values; .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Every setting below can also be passed as a CLI option (see README.md). The CLI option
# wins over the environment variable when both are given.
#
# The .env is read from the directory the harvester is run from. In Docker, pass it with
# `docker run --env-file .env ...` or individual -e flags instead.

# --- MOLGENIS target (required) ----------------------------------------------------------

# Authentication token of the user harvesting data. Treat as a secret.
MOLGENIS_TOKEN=replace-me

# MOLGENIS host to harvest into.
MOLGENIS_HOST=https://emx2.example.org

# Schema on the MOLGENIS host to harvest into.
MOLGENIS_SCHEMA=Eucaim

# Path to the harvester's TOML configuration (concept_table_link, harvester_config).
HARVEST_CONFIG=config.toml

# Source type to harvest: 'fdp' walks a FAIR Data Point, 'rdf' reads a plain DCAT graph.
INPUT_TYPE=fdp

# --- Source: set exactly one of FDP_URL or FDP_LIST_PATH ---------------------------------

# A single FAIR Data Point catalog URL.
FDP_URL=https://fdp.example.org

# Or a YAML file listing several FDPs to harvest in one run. One failing FDP does not stop
# the others; the run still exits non-zero.
# FDP_LIST_PATH=fdps.yaml

# Prefix for generated identifiers. With FDP_LIST_PATH, a per-entry prefix in the YAML
# overrides this.
# FDP_ID_PREFIX=testorg

# --- Logging ----------------------------------------------------------------------------

# Verbosity: INFO, WARNING or ERROR. An invalid value falls back to INFO and is reported.
LOG_LEVEL=INFO

# Base path for logging to disk. Logs always go to stdout; this adds a file on top.
# Every run writes its own timestamped file derived from this path, so no single file grows
# without bound:
#   /var/log/harvester/harvest.log -> /var/log/harvester/harvest_20240131-021500.log
# Leave unset to log to stdout only. The directory is created if it does not exist.
# LOG_FILE=/var/log/harvester/harvest.log

# How many run logs to keep. Older ones are deleted after the current run's file is created.
# Give LOG_FILE a directory of its own: pruning removes every sibling matching the run-log
# naming scheme, not only files this process created.
LOG_FILE_RETENTION=10
