@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix pubtype: <http://purl.org/adms/publishertype/> .

<http://example.com/creator1> a foaf:Agent ;
    foaf:name "Test Creator" ;
    dct:description "A creator agent" ;
    dct:type pubtype:Academia-ScientificOrganisation ;
    foaf:mbox <mailto:creator@example.com> ;
    foaf:homepage <https://creator.example.com> .
