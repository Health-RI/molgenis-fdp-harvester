@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix pubtype: <http://purl.org/adms/publishertype/> .

<http://example.com/org1> a foaf:Organization ;
    foaf:name "Test Publisher Org" ;
    dct:description "A test publishing organisation" ;
    dct:type pubtype:Academia-ScientificOrganisation ;
    foaf:mbox <mailto:org1@example.com> ;
    foaf:phone <tel:+31201234567> ;
    foaf:homepage <https://example.com> .
