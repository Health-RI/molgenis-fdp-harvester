@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/dataset_end_only> a dcat:Dataset ;
    dct:title "Test Dataset" ;
    dct:temporal <http://example.com/period_end_only> .

<http://example.com/period_end_only> a dct:PeriodOfTime ;
    dcat:endDate "2023-12-31"^^xsd:date .
