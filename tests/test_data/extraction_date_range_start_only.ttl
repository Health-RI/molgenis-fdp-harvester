@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/dataset_start_only> a dcat:Dataset ;
    dct:title "Test Dataset" ;
    dct:temporal <http://example.com/period_start_only> .

<http://example.com/period_start_only> a dct:PeriodOfTime ;
    dcat:startDate "2020-01-01"^^xsd:dateTime .
