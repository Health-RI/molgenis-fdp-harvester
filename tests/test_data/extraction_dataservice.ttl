@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<http://example.com/dataservice1> a dcat:DataService ;
    dct:title "Test Data Service" ;
    dct:description "A test data service" ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dct:conformsTo <http://example.com/standards/fhir> ;
    dcat:contactPoint <http://example.com/dataservice1/contact> ;
    dcat:endpointDescription "OpenAPI specification available for this service" ;
    dcat:endpointURL <http://example.com/dataservice1/api> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/JSON> ;
    dcat:keyword "test" ;
    dcat:landingPage <http://example.com/dataservice1/landing> ;
    dct:license <http://rdflicense.appspot.com/rdflicense/cc-by4.0> ;
    dct:publisher <http://example.com/dataservice1/publisher> ;
    dcat:theme <http://example.com/themes/health> .

<http://example.com/dataservice1/contact> a vcard:Kind ;
    vcard:fn "Data Service Contact" ;
    vcard:hasEmail <mailto:dataservice1.contact@example.com> .

<http://example.com/dataservice1/publisher> a foaf:Organization ;
    foaf:name "Data Service Publisher Org" .
