@prefix dct: <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix vcard: <http://www.w3.org/2006/vcard/ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix fdp: <http://fdp-2.test/>.
@prefix r: <http://data.europa.eu/r5r/>.
@prefix hea: <http://healthdataportal.eu/ns/health#>.
@prefix cat: <http://fdp-2.test/catalog/>.
@prefix adms: <http://www.w3.org/ns/adms#>.
@prefix EUC: <https://cancerimage.eu/ontology/EUCAIM#>.
@prefix dpv: <https://w3id.org/dpv#>.

fdp:new
    a dcat:Dataset, dcat:Resource;
    r:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj>;
    hea:healthCategory <http://publications.europa.eu/resource/authority/healthcategories/EHRS>;
    hea:healthTheme <http://publications.europa.eu/resource/authority/health-theme/CANCER_DISEASE>;
    hea:numberOfRecords "6"^^xsd:nonNegativeInteger;
    hea:numberOfUniqueIndividuals "5"^^xsd:nonNegativeInteger;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC>;
    dct:description "Test dataset 4 - description";
    dct:identifier "testdataset4-identifier";
    dct:isPartOf cat:__CATALOG_UUID__;
    dct:provenance [ a dct:ProvenanceStatement; rdfs:label "Test dataset 4 - Provenance statement" ];
    dct:publisher [ a foaf:Organization; foaf:homepage <https://cancerimage.eu>; foaf:name "Test dataset 4 - publisher" ];
    dct:spatial <http://publications.europa.eu/resource/authority/country/NLD>;
    dct:title "Test dataset 4";
    dct:type <https://cancerimage.eu/ontology/EUCAIM#SPEC1000020>;
    adms:interoperabilityLevel <https://cancerimage.eu/ontology/EUCAIM#SPEC1000009>;
    dcat:contactPoint [ a vcard:Kind; vcard:fn "Test dataset 4 - Contact point"; vcard:hasEmail <mailto:test@example.com> ];
    dcat:keyword "testkeyword";
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL>;
    dcat:version "1.0";
    EUC:collectionMethod <https://cancerimage.eu/ontology/EUCAIM#SPEC1000005>;
    EUC:hasBirthSex <https://cancerimage.eu/ontology/EUCAIM#COM1001370>;
    EUC:hasCondition <http://purl.bioontology.org/ontology/SNOMEDCT/109841003>;
    EUC:hasEquipmentManufacturer <https://cancerimage.eu/ontology/EUCAIM#IMG1000050>;
    EUC:hasImageBodyPart <http://purl.bioontology.org/ontology/SNOMEDCT/43799004>;
    EUC:hasImageModality <https://cancerimage.eu/ontology/EUCAIM#IMG1000038>;
    dpv:hasPurpose [ a dpv:Purpose ].