@prefix dct: <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix vcard: <http://www.w3.org/2006/vcard/ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix fdp: <http://fdp-1.test/>.
@prefix r: <http://data.europa.eu/r5r/>.
@prefix hea: <http://healthdataportal.eu/ns/health#>.
@prefix cat: <http://fdp-1.test/catalog/>.
@prefix adms: <http://www.w3.org/ns/adms#>.
@prefix EUC: <https://cancerimage.eu/ontology/EUCAIM#>.
@prefix dpv: <https://w3id.org/dpv#>.

fdp:new
    a dcat:Dataset, dcat:Resource;
    r:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj>;
    hea:healthCategory <http://13.81.34.152:1101/resource/authority/healthcategories/EHRS>;
    hea:healthTheme <http://13.81.34.152:1101/resource/authority/health-theme/ANTIMICROBIAL_CONTROL>;
    hea:numberOfRecords "6"^^xsd:nonNegativeInteger;
    hea:numberOfUniqueIndividuals "5"^^xsd:nonNegativeInteger;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC>;
    dct:description "sfdcsxz";
    dct:identifier "sobs";
    dct:isPartOf cat:__CATALOG_UUID__;
    dct:provenance [ a dct:ProvenanceStatement; rdfs:label "xdfgvdxn" ];
    dct:publisher
            [
                a foaf:Organization;
                foaf:homepage <https://cancerimage.eu>;
                foaf:name "xfgn forge"
            ];
    dct:spatial <http://publications.europa.eu/resource/authority/country/BEL>;
    dct:title "songs";
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL>;
    adms:interoperabilityLevel <https://cancerimage.eu/ontology/EUCAIM#SPEC1000009>;
    dcat:contactPoint
    [ a vcard:Kind; vcard:fn "dfbx"; vcard:hasEmail <mailto:test@test.com> ];
    dcat:keyword "Seth";
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL>;
    dcat:version "1.0";
    EUC:collectionMethod <https://cancerimage.eu/ontology/EUCAIM#SPEC1000005>;
    EUC:hasBirthSex <https://cancerimage.eu/ontology/EUCAIM#COM1001370>;
    EUC:hasCondition <https://cancerimage.eu/ontology/EUCAIM#CLIN1010238>;
    EUC:hasEquipmentManufacturer <https://cancerimage.eu/ontology/EUCAIM#IMG1000044>;
    EUC:hasImageBodyPart <https://cancerimage.eu/ontology/EUCAIM#BP1000055>;
    EUC:hasImageModality <https://cancerimage.eu/ontology/EUCAIM#IMG1000022>;
    dpv:hasPurpose [ a dpv:Purpose ].

